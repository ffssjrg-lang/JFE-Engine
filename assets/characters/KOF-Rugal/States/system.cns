type     = S
movetype = I
physics  = N
ctrl     = 0
velset   = 0,0
anim     = 101
sprpriority = 1

[State 101, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S0, 2
volumescale = 255
channel = 3

[State 101, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

