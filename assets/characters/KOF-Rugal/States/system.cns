;---------------------------------------------------------------------------
; Run
[Statedef 100]
type    = S
physics = S
anim = 100
ctrl = 0
velset = 0,0
sprpriority = 1

[State 100, PlaySnd]
type = PlaySnd
trigger1 = animelem = 3
trigger2 = animelem = 7
value = S4, 0
volumescale = 255
channel = 3

[State 100, 1]
type = VelSet
trigger1 = AnimElemtime(2) >= 0
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command = "holdup" || AILevel && enemynear, movetype = A
value = 40

[State 100, 5]
type = ChangeState
triggerall = time >= 14
trigger1 = command != "holdfwd"
trigger2 = RoundState >= 3
value = 101

;---------------------------------------------------------------------------
; Run Stop
