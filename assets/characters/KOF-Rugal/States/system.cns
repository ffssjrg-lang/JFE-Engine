trigger1 = (anim != [5051,5059]) && (anim != [5061,5069]) && (anim != [5091,5099])
trigger2 = !SelfAnimExist(5100 + (anim % 10))
value = 5100

[State 5100, 5] ;Hit ground anim (for hit up)
type = ChangeAnim
trigger1 = time = 0
trigger1 = (anim = [5051,5059]) || (anim = [5061,5069]); || (anim = [5091,5099])
trigger1 = SelfAnimExist(5100 + (anim % 10))
value = 5100 + (anim % 10)

[State 5100, 6]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5100, 7]
type = ChangeState
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
value = 5110 ;HIT_LIEDOWN

[State 5100, 8]
type = HitFallDamage
trigger1 = Time = 0

[State 5100, 9]
type = PosFreeze
trigger1 = 1

[State 5100, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 5101

