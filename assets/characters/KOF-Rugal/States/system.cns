;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = (Anim != [0,1]) && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0; + (Random%64 = 0)

[State 0, 2]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0

[State 0, 3] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

[State 0, 4]
type = DestroySelf
trigger1 = IsHelper

[State 0, 5]
type = AfterImage
trigger1 = time = 0
time = 1

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10

[State 10, 1]
type = VelSet
trigger1 = Time = 0
x = 0

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1]
type = VelSet
trigger1 = Time = 0
x = 0

[State 11, 2] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21
value = 21

[State 20, 5]
type = ChangeState 
trigger1 = RoundState >= 3
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
velset = 0,0
sprpriority = 1

[State 40, VarSet]
type = VarSet
trigger1 = Time = 0
var(16) = 0

[State 40, Turn]
type = Turn
trigger1 = Time = 0
trigger1 = p2dist x < 0
trigger1 = var(16) := 1

[State 40, NotHitBy]
type = NotHitBy
trigger1 = 1
value = , AT

[State 40, AfterImage]
type = AfterImage
trigger1 = time = 0
time = 1

[State 40, VarSet]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, VarSet]
type = VarSet
trigger1 = Time = 0
trigger1 = command = "holdfwd"
sysvar(1) = (1 + (command = "down" || (prevstateno = [100,101]))) * ifelse((var(16) = 1),-1,1)

[State 40, VarSet]
type = VarSet
trigger1 = Time = 0
trigger1 = command = "holdback"
sysvar(1) = (-1 - command = "down") * ifelse((var(16) = 1),-1,1)

[State 40, VelSet]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0,const(velocity.jump.neu.x),ifelse(sysvar(1)>=1,const(velocity.jump.fwd.x),const(velocity.jump.back.x)))*ifelse((sysvar(1)=2||sysvar(1)=-2),2.5,1)
y = const(velocity.jump.y) * ifelse((sysvar(1)=2||sysvar(1)=-2),0.85,1)

[State 40, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = command != "holdup"
value = 55
ctrl = 0

[State 40, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;-----------------------------------------------------------------
;Super Jump Start
[Statedef 41]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 41, reset]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 123, Direction]
type = varset
trigger1 = !AILevel
sysvar(1) = Ifelse(!time, 0, Ifelse(command="holdfwd", 1, Ifelse(command="holdback", -1, sysvar(1))))

[State 41, Direction]
type=varset
trigger1 = AILevel
sysvar(1) = Ifelse((enemynear, movetype != A || backedgebodydist <= 10), 1, Ifelse((enemynear, movetype=A), -1, 0))

[State 41, playsnd]
type = playsnd
trigger1 = !AnimTime
value = s3, 0
channel = 4

[State 41, Jump Sound]
type = PlaySnd
trigger1 = !AnimTime
value = s3, 1

[State 41, velset]
type = VelSet
trigger1 = !animtime
x = ifelse(sysvar(1)=0,const(velocity.jump.neu.x),ifelse(sysvar(1)>=1,const(velocity.jump.fwd.x),const(velocity.jump.back.x))) * 1.25
y = const(velocity.jump.y) * 1.25

[State 41, AfterImage Superjump]
type = AfterImage
trigger1 = AnimTime = 0
time = 16
palbright = 30,30,30
PalContrast = 256,256,256
paladd = 0,0,0
palmul = 1,1,1
trans = none
Length = 7
FrameGap = 3

[State 41, Change]
type = ChangeState
trigger1 = !animtime
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = PlaySnd
triggerall = time = 0
trigger1 = sysvar(1) = [-1,1]
value = s3,0

[State 50, 2]
type = PlaySnd
triggerall = time = 0
trigger1 = sysvar(1) = 2 || sysvar(1) = -2
value = s3,1

[State 50, 3]
type = AfterImage
triggerall = time = 0
trigger1 = sysvar(1) = 2 || sysvar(1) = -2
time = 16
palbright = 30,30,30
PalContrast = 256,256,256
paladd = 0,0,0
palmul = 1,1,1
trans = none
Length = 7
FrameGap = 3

[State 50, 4]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 5]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, AI Air-to-Air]
type = changestate
value = 640
triggerall = AILevel && NumEnemy
triggerall = P2BodyDist X = [-75, 75]
triggerall = Vel Y > 2
triggerall = Random < AILevel * 125
trigger1 = 1

[State 50, 6]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
anim    = 47
ctrl    = 0
velset  = 0,0

[State 52, Control]
type = Explod
trigger1 = prevstateno = [1200, 1230]
trigger2 = (prevstateno = [1600, 1630]) && !movehit
anim = 9741 ;6900 / 20000
id = 52
pos = 0,0
postype = p1
removetime = -1
ignorehitpause = 1

[State 52, VarSet]
type = VarSet
trigger1 = Time = 0
sysvar(3) = 0

[State 52, VarSet]
type = VarSet
trigger1 = prevstateno = 155 ||(prevstateno = [290,299]) || prevstateno = 5040
sysvar(3) = 1

[State 52, ChangeState]
type = ChangeState
trigger1 = Time = 0
value = 53
ctrl = 0

[Statedef 53]
type    = S
physics = S
anim    = 47
ctrl    = 0
velset  = 0,0

[State 52, Turn]
type = Turn
trigger1 = sysvar(3) != 1
trigger1 = Time = 0
trigger1 = p2dist x < 0

[State 52, NotHitBy]
type = NotHitBy
trigger1 = sysvar(3) = 1
value = SCA
time = 2

[State 52, PosSet]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = s4,0

[state 52, Explod]
type = Explod
trigger1 = sysvar(3) = 1
trigger1 = time = 0
anim = 6052
postype = P1
pos = -32, 0
facing = -1
sprpriority = 2
ownpal = 1

[state 52, CtrlSet]
type = CtrlSet
trigger1 = !numexplod(52)
trigger1 = sysvar(3) != 1
trigger1 = time = 0
value = 1

[State 52, RemoveExplod]
type = RemoveExplod
trigger1 = !time
id = 52

[State 52, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

