;==========[ REPPUKEN ]==========
[Statedef 1000]
type    = S
movetype= A
physics = S
poweradd= 10 + (Var(59) * 50)
velset = 0, 0
anim = 1000
ctrl = 0
sprpriority = 2

[State 1000, Strength]
type = VarSet
trigger1 = !Time
v = 10
value = Cond(Command = "a", 0, 1)
ignorehitpause = 1

[State 1000, Voice]
type = PlaySnd
trigger1 = AnimElem = 2
value = s10, 20
channel = 2

[State 1000, Effect]
type = PlaySnd
trigger1 = AnimElem = 4
value = s12, 3

[State 1000, Effect]
type = Explod
trigger1 = AnimElem = 3
anim = 1001
ID = 1001
pos = 16, 0
postype = p1
facing = 1
bindtime = -1
removetime = 32
pausemovetime = 0
scale = 1, 1
sprpriority = 4
ownpal = 1
removeongethit = 1
ignorehitpause = 1

[State 1000, Reppuken]
type = Helper
trigger1 = animelem = 7
StateNo = 1005
ID = 1005
pos = 32, 0
postype = p1
scale = const(size.xscale), const(size.yscale)
ignorehitpause = 1
ownpal = 1

[State 1000, ChangeAnim]
type = ChangeAnim
trigger1 = animelemtime(10) >= 12 && animelemtime(11) < 0 && !var(10)
value = anim
elem = 11
ignorehitpause = 1

[State 1000, Explod Var]
type = Explod
trigger1 = animelemtime(7) > 0
trigger1 = fvar(6)
anim = 9741 ;6900 / 20000
id = 100010
pos = 0,0
postype = p1
removetime = -1
ignorehitpause = 1

[State 1000, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;===================[ REPPUKEN HELPER ]=======================
[Statedef 1005]
type = S
physics = N
movetype = A
anim = 1005
ctrl = 0
juggle = 0
velset = 0, 0
sprpriority = 4

[State 1005, AfterImage]
type = AfterImage
trigger1 = !time 
time = 999
TimeGap  = 1
FrameGap = 2
length = 10
palcolor = 256
paladd = 100, 0, 100
palmul = .240, .20, .225
palcontrast = 256, 256, 256
trans = add

[State 1005, HitOverride]
type = hitoverride
trigger1 = 1
time = -1
attr = SCA, AA, AP, AT
stateno = 1006
ignorehitpause = 1

[State 1005, HB]
type = hitby
trigger1 = 1
time = -1
value = SCA, NP, SP, HP
ignorehitpause = 1

[State 1005, Strength]
type = varset
trigger1 = !time
var(10) = root, var(10)

[State 1005, Vel]
type = velset
trigger1 = 1
x = cond(var(10) > 0, 7 + (var(10) = 2), 5)
y = 0

[State 1005, Hit]
type = hitdef
trigger1 = var(10) != 2
priority = 4, Hit
attr = S, SP
damage = cond(var(10) = 2, 125, 50 * (var(10) + 1)), 15
animtype = Heavy
hitflag = MAF
guardflag = MA
pausetime = 12, 12
;====================
sparkno = S6002
guard.sparkno = S6012
sparkxy = -10, 0
;====================
hitsound = s1, 1
guardsound = s2, 1
;====================
ground.type = Low
ground.slidetime = cond(root, var(59), 36, 20)
ground.hittime = cond(root, var(59), 36, 20)
guard.hittime = 9
guard.ctrltime = 9
ground.velocity = -10
ground.cornerpush.veloff = 0
air.velocity = -4, -4
;====================
fall = Root, NumExplod(100010)
air.fall = 1
fall.recover = 1
fall.recovertime = 0
;====================
getpower = 0, 0
givepower = 36, 36
;====================
envshake.time = 12
envshake.ampl = 2
;====================
yaccel = 0.5
airguard.ctrltime = 16
forcestand = 1
;====================

[State 1005, Hit]
type = hitdef
trigger1 = var(10) = 2
priority = 4, Hit
attr = S, SP
damage = 125, 15
animtype = Heavy
hitflag = MAF
guardflag = MA
pausetime = 12, 12
;====================
sparkno = S6002
guard.sparkno = S6012
sparkxy = -10, 0
;====================
hitsound = s1, 1
guardsound = s2, 1
;====================
ground.type = Low
ground.slidetime = 36
ground.hittime = 36
guard.hittime = 9
guard.ctrltime = 9
ground.velocity = -10
ground.cornerpush.veloff = 0
air.velocity = -4, -4
;====================
fall = 0
air.fall = 1
fall.recover = 1
fall.recovertime = 0
;====================
getpower = 0, 0
givepower = 36, 36
;====================
envshake.time = 12
envshake.ampl = 2
;====================
yaccel = 0.5
airguard.ctrltime = 16
forcestand = 1
;==================
p2stateno = 2006
;==================

[State 1005, Super Cancel Var]
type = parentVarSet
trigger1 = movehit = 1
fv = 6
value = 1
ignorehitpause = 1

[State 1005, Juggle Var]
type = parentVarAdd
trigger1 = movehit = 1
fv = 4
value = 5
ignorehitpause = 1

[State 1005, End]
type = changestate
trigger1 = movecontact
value = 1006
ignorehitpause = 1

[State 1005, ChangeState]
type = ChangeState
trigger1 = MoveReversed
value = 1006
ignoreHitPause = 1

[State 1005, End]
type = destroyself
trigger1 = pos x != [ -360 , 360 ] 

