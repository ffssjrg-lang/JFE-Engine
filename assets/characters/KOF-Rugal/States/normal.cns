;===================[ TIME OVER LOSE ]===================
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;================[ WIN POSE INITIATE ]================
[Statedef 180]
type = S
ctrl = 0
anim = 181 + random % 3
velset = 0,0

;=[ REGULAR STUFF ]=

[State 180, Voice]
type = PlaySnd
trigger1 = animelem = 3 && anim = 181
value = S10, 6
channel = 2

[State 180, Voice]
type = PlaySnd
trigger1 = animelem = 3 && anim = 181
value = S12, 0

[State 180, Voice]
type = PlaySnd
trigger1 = animelem = 6 && anim = 182
value = S1, 6

[State 180, Voice]
type = PlaySnd
trigger1 = animelem = 6 && anim = 182
value = S10, 4
channel = 2

[State 180, Voice]
type = PlaySnd
trigger1 = animelem = 9 && anim = 183
value = S1, 6

[State 180, Voice]
type = PlaySnd
trigger1 = animelem = 7 && anim = 183
value = S10, 2
channel = 2

[State 182, EnvShake]
type = EnvShake
trigger1 = animelem = 6 && anim = 182 || animelem = 9 && anim = 183
time = 8
freq = 120
ampl = 3

[State 180, Effect]
type = Explod
trigger1 = AnimElem = 3 && anim = 181
anim = 184
ID = 184
pos = 0, 0
postype = p1
facing = 1
bindtime = -1
removetime = 15
pausemovetime = 0
scale = const(size.xscale), const(size.yscale)
sprpriority = 4
ownpal = 1
removeongethit = 1
ignorehitpause = 1

[State 180, Effect]
type = Explod
trigger1 = AnimElem = 6 && anim = 182
anim = 185
ID = 185
pos = 0, -100
postype = p1
facing = 1
bindtime = -1
removetime = 30
pausemovetime = 0
scale = const(size.xscale), const(size.yscale)
sprpriority = 4
ownpal = 1
removeongethit = 1
ignorehitpause = 1

[State 180, Effect]
type = Explod
trigger1 = AnimElem = 2 && anim = 183
anim = 186
ID = 186
pos = 0, 0
postype = p1
facing = 1
bindtime = -1
removetime = 126
pausemovetime = 0
scale = const(size.xscale), const(size.yscale)
sprpriority = 4
ownpal = 1
removeongethit = 1
ignorehitpause = 1

;=[ SYSTEM STUFF ]=

[State 180, Invulnerable]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 180, Winner Announce]
type = PlaySnd
trigger1 = !time
value = S15, 0

[State 180, Winner!]
type = Explod
trigger1 = !time
anim = 8110
ID = 8110
pos = ceil(gamewidth - cond(teamside = 1,cond(facing=1,275,48),cond(facing=1,48,275))), floor(gameheight - 150)
postype = back
facing = facing * ifelse(facing, 1, -1)
sprpriority = 22667
removetime = 122
bindtime = -1
scale = 0.75, 0.75
ownpal = 1
ignorehitpause = 1

[State 180, Perfect Announce]
type = PlaySnd
trigger1 = time = 100 && life >= lifemax
value = S15, 1

[State 180, Perfect!]
type = Explod
trigger1 = time = 100 && life >= lifemax
anim = 8120
ID = 8120
pos = ceil(gamewidth - cond(teamside = 1,cond(facing=1,162,150),cond(facing=1,165,162))), floor(gameheight - 128)
postype = back
facing = facing * ifelse(facing, 1, -1)
sprpriority = 22668
removetime = 122
bindtime = -1
scale = 1, 1
ownpal = 1
ignorehitpause = 1

[State 180, Screen Transition]
type = Explod
trigger1 = time >= 275 && !numexplod(8001)
anim = 8001
ID = 8001
ontop = 1
postype = left
scale = 500.0,10.0
ownpal = 1
bindtime = -1
removetime = -1
ignorehitpause = 1

[State 180, Round Not Over]
type = AssertSpecial
trigger1 = time <= cond(life >= lifemax, 400, 300)
flag = RoundNotOver
flag2 = NoBarDisplay

;================[ INTRO ]================
[Statedef 190]
