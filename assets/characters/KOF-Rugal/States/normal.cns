postype = p1
facing = 1
bindtime = -1
removetime = 126
pausemovetime = 0
scale = const(size.xscale), const(size.yscale)
sprpriority = 4
ownpal = 1
removeongethit = 1
ignorehitpause = 1

[State 190, Intro]
